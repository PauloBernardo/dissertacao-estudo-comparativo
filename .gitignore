# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/
*.so

# Virtual environment
.venv/
venv/
env/

# Data (downloaded — reproduced via scripts/download_data.py)
data/raw/
# Exception: parquet cache allows clone-and-run without re-downloading from UCI
!data/raw/*.parquet

# Results (large — excluded from version control)
results/*.json
results/*.csv
results/*.parquet

# Exception: tuning best_params is small and important for reproducibility
!results/tuning/best_params.json

# Optuna study DBs
*.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# LaTeX intermediates (keep .tex and .pdf)
*.aux
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
